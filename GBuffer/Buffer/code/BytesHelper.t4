#><#
    void WriteUtf8(string className, bool returnSelf) {
#>

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public static <#= returnSelf ? className : "void" #> <#= nameof(WriteUtf8) #>(this <#= className #> self, string value, bool bigEndian = false) {
            if (string.IsNullOrEmpty(value)) {
                self.Advance(SpanByteUtils.<#= nameof(WriteUtf8) #>(self.GetSpan(sizeof(ushort)), value, bigEndian));
                return <#= returnSelf ? "self" : "" #>;
            }

            var maxLength = value.Length * 3;
            if (self.WritableCount >= maxLength + sizeof(ushort)) {
                self.Advance(SpanByteUtils.<#= nameof(WriteUtf8) #>(self.Span, value, bigEndian));
            } else {
                var count = System.Text.Encoding.UTF8.GetByteCount(value);
                if (count > short.MaxValue) throw new ArgumentOutOfRangeException(nameof(value));
                self.Advance(SpanByteUtils.<#= nameof(WriteUtf8) #>(self.GetSpan(count + sizeof(ushort)), value, bigEndian));
            }
<#
        if (returnSelf) {
#>
            return self;
<#
        }
#>
        }
<#
    }
